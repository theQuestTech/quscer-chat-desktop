{
  "name": "quscer-chat-desktop",
  "version": "0.1.0",
  "description": "Desktop app for Quscer Chat",
  "main": "src/main.js",
  "author": "Quscer",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.9"
  },
  "build": {
    "appId": "com.quscer.chat",
    "productName": "Quscer Chat",
    "files": [
      "src/**/*",
      "build/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "theQuestTech",
      "repo": "quscer-chat-desktop"
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.business",
      "target": ["dmg", "zip"],
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "win": {
      "icon": "build/icon.ico",
      "target": ["nsis"],
      "signAndEditExecutable": true
    },
    "linux": {
      "icon": "build/icon.png",
      "target": ["AppImage", "deb"],
      "category": "Network"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
